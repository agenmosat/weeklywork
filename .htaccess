RewriteEngine On

# Paksa pengalihan seluruh traffic HTTP ke HTTPS
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# biar file.php redirect ke /php (ga penting sebenernya :v)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
# biar ekstensi .php ga keliatan
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^ %{REQUEST_URI}.php [L]
RewriteRule ^images/(.*)$ home/images/$1 [L]

# Nonaktifkan directory browsing (opsional, untuk keamanan)
Options -Indexes

ErrorDocument 404 /errors/404.php
