RewriteEngine On

# Paksa pengalihan seluruh traffic HTTP ke HTTPS
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteRule ^images/(.*)$ home/images/$1 [L]

# Nonaktifkan directory browsing (opsional, untuk keamanan)
Options -Indexes

ErrorDocument 404 /errors/404.php
